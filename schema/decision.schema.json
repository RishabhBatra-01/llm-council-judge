{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llm-council/decision.schema.json",
  "title": "Decision Object",
  "description": "The output contract of the LLM Council. A refused or no_decision result is a fully valid Decision Object, not an error.",
  "type": "object",
  "required": [
    "decision_id", "schema_version", "created_at", "status", "question",
    "winning_answer", "runner_up_answer", "confidence", "risks", "citations",
    "provenance", "audit_ref"
  ],
  "additionalProperties": false,
  "properties": {
    "decision_id": { "type": "string", "format": "uuid" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["decided", "refused", "no_decision"] },
    "question": { "type": "string" },
    "winning_answer": { "type": ["string", "null"] },
    "runner_up_answer": { "type": ["string", "null"] },

    "confidence": {
      "type": "object",
      "required": ["score", "method", "signals"],
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "number", "minimum": 0.0, "maximum": 1.0,
          "description": "EARNED. Derived from observable signals below. Never a model's self-report."
        },
        "method": { "type": "string", "minLength": 1 },
        "signals": {
          "type": "object",
          "required": [
            "inter_judge_agreement", "score_margin",
            "agent_agreement", "verification_pass_rate"
          ],
          "additionalProperties": false,
          "description": "null means the signal could not be measured. That is distinct from 0.0 and from 1.0, and its weight is dropped and the others renormalised.",
          "properties": {
            "inter_judge_agreement":  { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
            "score_margin":           { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
            "winner_quality":         { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
            "agent_agreement":        { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
            "verification_pass_rate": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 }
          }
        },
        "raw_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "contributions": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "caps_triggered": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ceilings that fired. The lowest one bounds the final score."
        }
      }
    },

    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "severity", "detail"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["factual", "safety", "ambiguity", "data_gap"] },
          "severity": { "enum": ["low", "med", "high"] },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },

    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "source", "status"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "source": { "type": "string" },
          "status": {
            "enum": ["verified", "unverified", "failed"],
            "description": "verified = reachable AND the claim's wording plausibly appears. unverified = reachable but unconfirmed. failed = unreachable. Reachability is not truth."
          },
          "label": { "type": ["string", "null"] },
          "detail": { "type": "string" },
          "http_status": { "type": ["integer", "null"] }
        }
      }
    },

    "provenance": {
      "type": "object",
      "required": ["generators", "judges", "config_hash", "cost_usd", "total_latency_ms"],
      "additionalProperties": false,
      "properties": {
        "generators": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["model_id", "family", "latency_ms", "tokens"],
            "properties": {
              "model_id": { "type": "string" },
              "family": { "type": "string" },
              "served_by": {
                "type": ["string", "null"],
                "description": "What the provider reported actually running, which can differ from what we requested."
              },
              "label": { "type": ["string", "null"] },
              "ok": { "type": "boolean" },
              "abstained": { "type": "boolean" },
              "failure_stage": { "enum": ["network", "http", "parse", "content", null] },
              "detail": { "type": "string" },
              "latency_ms": { "type": "integer", "minimum": 0 },
              "tokens": { "type": "integer", "minimum": 0 },
              "attempts": { "type": "integer", "minimum": 0 },
              "cost_usd": { "type": "number", "minimum": 0 }
            }
          }
        },
        "judges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["model_id", "family", "rubric_scores"],
            "properties": {
              "model_id": { "type": "string" },
              "family": { "type": "string" },
              "ok": { "type": "boolean" },
              "detail": { "type": "string" },
              "parse_method": { "enum": ["direct", "unfenced", "sliced", null] },
              "repair_calls": { "type": "integer", "minimum": 0 },
              "problems": { "type": "array", "items": { "type": "string" } },
              "latency_ms": { "type": "integer", "minimum": 0 },
              "tokens": { "type": "integer", "minimum": 0 },
              "cost_usd": { "type": "number", "minimum": 0 },
              "rubric_scores": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": { "type": "number", "minimum": 0, "maximum": 5 }
                }
              },
              "justification": {
                "type": "object",
                "additionalProperties": { "type": "string", "maxLength": 300 }
              }
            }
          }
        },
        "config_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "cost_usd": { "type": "number", "minimum": 0 },
        "total_latency_ms": { "type": "integer", "minimum": 0 },
        "workings": {
          "type": "object",
          "description": "How the aggregator got there. Not required by the contract; included so a reviewer can retrace the arithmetic."
        }
      }
    },

    "audit_ref": {
      "type": ["string", "null"],
      "description": "Hash of the audit-log entry recording this decision."
    }
  }
}
